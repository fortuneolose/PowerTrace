# Copy to .env in the repo root and fill in. NEVER commit .env (the repo is public).

# Atlas connection string: Atlas > your cluster > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=PowerTrace

# Two databases, same `nodes` / `events` collections and same queries; only the size differs.
DEMO_DB=powertrace_demo
HOSPITAL_DB=powertrace_hospital

# Backend (and mock server) port
PORT=3000

# Public URL from the cloudflared tunnel; used for the QR code
PUBLIC_URL=https://example.trycloudflare.com
