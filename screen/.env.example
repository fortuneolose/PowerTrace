# Copy to screen/.env.local. Leave unset to use http://localhost:3000 in dev and same-origin in the build.
VITE_API_URL=http://localhost:3000

# Optional: the phone URL shown as a QR code on the main screen (defaults to <API origin>/join).
# Set this to the tunnel URL if you run the screen from Vite during the demo.
# VITE_JOIN_URL=https://example.trycloudflare.com/join
